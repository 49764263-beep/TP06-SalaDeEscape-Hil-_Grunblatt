<div class="sala sala4">
    <div class="caja juego quiz">
        <p class="subtitulo">SALA 4 · LEÓN COBARDE</p>
        <h1>El Quiz de Oz</h1>
        <p>Necesitás al menos 4 respuestas correctas.</p>

        <div class="pregunta">
            <h2>1. ¿Cómo se llama la protagonista?</h2>
            <button onclick="responderQuiz(this, true)">Dorothy</button>
            <button onclick="responderQuiz(this, false)">Glinda</button>
            <button onclick="responderQuiz(this, false)">Elphaba</button>
        </div>
        <div class="pregunta">
            <h2>2. ¿Qué desea el Espantapájaros?</h2>
            <button onclick="responderQuiz(this, false)">Un corazón</button>
            <button onclick="responderQuiz(this, true)">Un cerebro</button>
            <button onclick="responderQuiz(this, false)">Una casa</button>
        </div>
        <div class="pregunta">
            <h2>3. ¿Qué desea el Hombre de Hojalata?</h2>
            <button onclick="responderQuiz(this, true)">Un corazón</button>
            <button onclick="responderQuiz(this, false)">Valor</button>
            <button onclick="responderQuiz(this, false)">Un cerebro</button>
        </div>
        <div class="pregunta">
            <h2>4. ¿Qué desea el León Cobarde?</h2>
            <button onclick="responderQuiz(this, false)">Inteligencia</button>
            <button onclick="responderQuiz(this, true)">Valor</button>
            <button onclick="responderQuiz(this, false)">Riqueza</button>
        </div>
        <div class="pregunta">
            <h2>5. ¿Qué camino sigue Dorothy?</h2>
            <button onclick="responderQuiz(this, true)">Ladrillos amarillos</button>
            <button onclick="responderQuiz(this, false)">Piedras rojas</button>
            <button onclick="responderQuiz(this, false)">Flores</button>
        </div>

        <p id="resultadoQuiz" class="mensaje"></p>
        <form id="formSala5" action='@Url.Action("TerminarSala4", "Home")' method="POST" style="display:none;">
            <button class="boton" type="submit">Continuar</button>
        </form>
    </div>
</div>
