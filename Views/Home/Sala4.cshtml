<h1>Quiz Oz</h1>

<section class="quiz">
    <div>
        <h2>¿Cómo se llama la protagonista de la historia?</h2>
        <button>Glinda</button>
        <button>Dorothy</button>
        <button>Elphaba</button>
        <button>Annie</button>
    </div>

    <div>
