<div class="sala sala2">
    <div class="caja juego">
        <p class="subtitulo">SALA 2 · HOMBRE DE HOJALATA</p>
        <h1>Los aceites de Oz</h1>
        <p>Colocá cada aceite en el lugar correcto para reparar al Hombre de Hojalata.</p>

        <div class="aceites">
            <div class="aceite" id="aceite1" onclick="elegirAceite(1)">Aceite de corazón</div>
            <div class="aceite" id="aceite2" onclick="elegirAceite(2)">Aceite de valor</div>
            <div class="aceite" id="aceite3" onclick="elegirAceite(3)">Aceite de inteligencia</div>
        </div>

        <div class="lugares">
            <button type="button" onclick="ponerAceite(1)">Lugar 1</button>
            <button type="button" onclick="ponerAceite(2)">Lugar 2</button>
            <button type="button" onclick="ponerAceite(3)">Lugar 3</button>
        </div>

        <p id="mensajeSala2" class="mensaje"></p>
        <form id="formSala3" action='@Url.Action("AvanzarSala", "Home")' method="POST" style="display:none;">
            <button class="boton" type="submit">Continuar</button>
        </form>
    </div>
</div>
