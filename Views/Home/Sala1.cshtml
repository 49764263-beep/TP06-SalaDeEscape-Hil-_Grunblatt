<div class="sala sala1">
    <div class="caja juego">
        <p class="subtitulo">SALA 1 · ESPANTAPÁJAROS</p>
        <h1>El acertijo del Espantapájaros</h1>
        <p>El Espantapájaros está frente a una puerta cerrada.</p>
        <p>Para abrirla tenés que descubrir la palabra secreta antes de quedarte sin intentos.</p>

        <input type="hidden" id="Palabra" value="@ViewBag.Palabra" />
        <h2 id="PalabraOculta">@ViewBag.PalabraOculta</h2>

        <p>Letras fallidas:</p>
        <div id="LetrasFallidas" class="dato">Ninguna</div>
        <p>Intentos restantes: <span id="Intentos">10</span></p>

        <input type="text" id="Letra" maxlength="1" placeholder="Letra" />
        <button class="boton" type="button" onclick="arriesgarLetra()">Arriesgar</button>
        <p id="Rta" class="mensaje"></p>

        <form id="formSiguienteSala" action='@Url.Action("AvanzarSala", "Home")' method="POST" style="display:none;">
            <button class="boton" type="submit">Continuar</button>
        </form>
    </div>
</div>
